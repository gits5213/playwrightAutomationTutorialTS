{
  "name": "playwright-automation-tutorial-ts",
  "version": "1.0.0",
  "private": true,
  "description": "Step-by-step Playwright TypeScript tutorial for maintainable, reusable, scalable tests.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:smoke": "playwright test --grep @smoke",
    "test:basic": "playwright test tests/basic",
    "test:e2e": "playwright test tests/e2e",
    "test:api": "playwright test tests/api",
    "test:data": "playwright test tests/e2e/todo.data-driven.spec.ts",
    "test:keywords": "playwright test tests/e2e/todo.keywords.spec.ts",
    "report": "playwright show-report",
    "codegen": "playwright codegen https://demo.playwright.dev/todomvc"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@types/node": "^22.10.0"
  }
}
